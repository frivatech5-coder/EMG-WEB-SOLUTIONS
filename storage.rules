rules_version = '2';

// Public can read site images. Only the administrator e-mail can upload/delete (images up to 5 MB).
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == 'frivatech5@gmail.com';
    }
    match /site-images/{folder}/{file} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
